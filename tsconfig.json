{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    // A `lib/` module that is shared with the Deno Edge Functions must spell its
    // own intra-lib imports with the `.ts` extension, because Deno will not
    // resolve an extensionless specifier and CI type-checks that graph
    // (`deno test` over supabase/functions). Safe here: `noEmit` is on, so no
    // emitted path is ever rewritten, and Metro/esbuild both resolve it.
    // First needed by lib/trialProtein.ts (B-351 slice 5).
    "allowImportingTsExtensions": true
  },
  // `supabase/functions` is Deno-typed (its own `deno test` type-check is the gate,
  // and it is the ONLY type check over that path). `scripts/**/*.deno.ts` is the same
  // graph living outside that directory — a Deno entry point that imports the Edge
  // Function modules — so it carries the suffix to stay out of the app's tsc run
  // rather than being excluded by name, which the next such script would forget.
  //
  // The glob is RECURSIVE, and that is the fix for the exact forgetting the comment
  // above predicts (CUL-677): it was `scripts/*.deno.ts`, one level only, so the
  // first such script written inside a subdirectory
  // (scripts/w1-other-row-swap/predictChronicity.deno.ts) landed back in the app's
  // tsc run and failed on `Deno` being undefined. The suffix was carrying its half of
  // the contract; the pattern was not.
  "exclude": ["supabase/functions", "docs/design-system", "scripts/**/*.deno.ts"]
}
