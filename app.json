{
  "expo": {
    "name": "Culprit",
    "slug": "project-nyx",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "nyx",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.projectnyx.app",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "Culprit saves a vet document to your photo library only when you choose Save Image."
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["1C8F.1", "CA92.1"]
          }
        ]
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.projectnyx.app"
        ]
      }
    },
    "android": {
      "package": "com.projectnyx.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#13112E"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "6928a16e-3d2e-4a2e-ac87-b6c20176430b"
      }
    },
    "owner": "project-nyx",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6928a16e-3d2e-4a2e-ac87-b6c20176430b"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Culprit uses your photo library so you can attach a saved photo of a meal, a symptom, a medication label, vet paperwork, or your pet. If you allow it, Culprit sends label and symptom photos to Claude, an AI made by Anthropic, to read them.",
          "cameraPermission": "Culprit uses the camera so you can photograph a meal, a symptom, a medication label, vet paperwork, or your pet. If you allow it, Culprit sends label and symptom photos to Claude, an AI made by Anthropic, to read them.",
          "microphonePermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#13112E"
        }
      ],
      "expo-sqlite",
      "expo-status-bar",
      "./plugins/withoutPushEntitlement",
      "./plugins/withWidgetIphoneOnly",
      "./plugins/withoutLiveActivities",
      "./plugins/withWidgetPrivacyManifest",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.projectnyx.app",
          "widgets": [
            {
              "name": "CulpritWidget",
              "displayName": "Culprit",
              "description": "See what's been logged today at a glance — meals, treats, meds, and symptoms.",
              "ios": {
                "supportedFamilies": ["systemMedium"],
                "configuration": {
                  "title": "Pet",
                  "description": "Pick which pet this widget is for. Pet slots follow the order you added your pets — the widget shows the name so you can check.",
                  "parameters": {
                    "petSlot": {
                      "title": "Pet",
                      "type": "enum",
                      "default": "slot1",
                      "values": [
                        { "name": "Pet 1", "value": "slot1" },
                        { "name": "Pet 2", "value": "slot2" },
                        { "name": "Pet 3", "value": "slot3" },
                        { "name": "Pet 4", "value": "slot4" },
                        { "name": "Pet 5", "value": "slot5" },
                        { "name": "Pet 6", "value": "slot6" }
                      ]
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    ]
  }
}
